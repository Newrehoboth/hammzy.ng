// Build a lookup map for quick access by ID
const COUNTRY_BY_ID = new Map<number, TigerCountry>(
  TIGER_COUNTRIES.map((c) => [c.id, c])
);

export function getCountryById(id: number): TigerCountry | undefined {
  return COUNTRY_BY_ID.get(id);
}

// ─── API Functions ───────────────────────────────────────────────────────────

/**
 * Get balance from Tiger SMS.
 * Response: ACCESS_BALANCE:11.57
 */
export async function tigerGetBalance(): Promise<number> {
  const text = await tigerRequest({ action: "getBalance" });
  if (!text.startsWith("ACCESS_BALANCE:")) {
    throw new Error(`Tiger SMS balance error: ${text}`);
  }
  return parseFloat(text.split(":")[1]);
}

/**
 * Get all countries (static list — Tiger SMS has no country list API).
 */
export function tigerGetCountries(): TigerCountry[] {
  return TIGER_COUNTRIES;
}

/**
 * Get available products/services for a country using getPrices.
 * Response: {"countryId":{"serviceCode":{"cost":"0.50","count":100}}}
 */
export async function tigerGetPricesForCountry(
  countryId: number
): Promise<Record<string, { cost: number; count: number }>> {
  try {
    const text = await tigerRequest({ action: "getPrices", country: String(countryId) });
    // If the API returns an error string (not JSON)
    if (!text.startsWith("{")) {
      console.error(`Tiger SMS getPrices error for country ${countryId}: ${text}`);
      return {};
    }
    const raw: TigerPricesRaw = JSON.parse(text);
    const countryData = raw[String(countryId)];
    if (!countryData) return {};
    // Normalize cost from string to number
    return Object.fromEntries(
      Object.entries(countryData).map(([svc, data]) => [
        svc,
        { cost: parseFloat(data.cost), count: data.count },
      ])
    );
  } catch (err) {
    console.error(`Tiger SMS getPrices error for country ${countryId}:`, err);
    return {};
  }
}

/**
 * Get available products for a country (returns TigerProduct[] with price in USD).
 */
export async function tigerGetProducts(countryId: number): Promise<TigerProduct[]> {
  const pricesData = await tigerGetPricesForCountry(countryId);
  return Object.entries(pricesData)
    .filter(([, data]) => data.count > 0)
    .map(([code, data]) => ({
      name: getServiceDisplayName(code),
      qty: data.count,
      price: data.cost,
    }))
    .sort((a, b) => b.qty - a.qty);
}

/**
 * Get prices for a specific service across a country.
 */
export async function tigerGetPriceForService(
  countryId: number,
  service: string
): Promise<{ cost: number; count: number } | null> {
  const serviceCode = getServiceCode(service);
  const prices = await tigerGetPricesForCountry(countryId);
  return prices[serviceCode.toLowerCase()] ?? null;
}

/**
 * Buy a virtual number.
 * Response: ACCESS_NUMBER:activationId:phoneNumber
 */
export async function tigerBuyNumber(
  countryId: number,
  service: string
): Promise<TigerOrder> {
  const serviceCode = getServiceCode(service);
  const text = await tigerRequest({
    action: "getNumber",
    service: serviceCode.toLowerCase(),
    country: String(countryId),
  });

  if (text === "NO_NUMBERS") {
    throw new Error(`No phone numbers available for ${service} right now. Please try another country.`);
  }
  if (text === "NO_BALANCE") {
    throw new Error("Insufficient funds in the master account wallet. Please contact admin.");
  }
  if (text === "BAD_SERVICE") {
    throw new Error(`Service "${service}" is not supported. Please choose another.`);
  }
  if (text === "BAD_COUNTRY") {
    throw new Error(`Country is not supported. Please choose another.`);
  }
  if (!text.startsWith("ACCESS_NUMBER:")) {
    throw new Error(`Tiger SMS buy error: ${text}`);
  }

  // ACCESS_NUMBER:activationId:phoneNumber
  const parts = text.split(":");
  const activationId = parts[1];
  const phone = parts[2];

  // Expiry: Tiger SMS numbers are typically valid for 20 minutes
  const expiresAt = new Date(Date.now() + 20 * 60 * 1000).toISOString();

  return {
    id: activationId,
    phone,
    service: getServiceDisplayName(serviceCode),
    country: countryId,
    price: 0, // Price is looked up from getPrices before purchasing
    status: "pending",
    expiresAt,
    sms: [],
  };
}

/**
 * Check the status of an activation order.
 * Responses:
 *   STATUS_WAIT_CODE    → pending (waiting for SMS)
 *   STATUS_WAIT_RETRY   → received (waiting for another SMS)
 *   STATUS_OK:CODE      → received (code in hand)
 *   ACCESS_CANCEL       → canceled
 */
export interface TigerStatusResult {
  status: TigerOrderStatus;
  code: string | null;
}

export async function tigerGetStatus(activationId: string): Promise<TigerStatusResult> {
  const text = await tigerRequest({ action: "getStatus", id: activationId });

  if (text === "STATUS_WAIT_CODE") {
    return { status: "pending", code: null };
  }
  if (text === "STATUS_WAIT_RETRY") {
    return { status: "received", code: null };
  }
  if (text === "ACCESS_CANCEL") {
    return { status: "canceled", code: null };
  }
  if (text.startsWith("STATUS_OK:")) {
    const code = text.substring("STATUS_OK:".length);
    return { status: "received", code };
  }
  if (text === "NO_ACTIVATION") {
    return { status: "canceled", code: null };
  }

  console.warn(`Tiger SMS unknown status for ${activationId}: ${text}`);
  return { status: "pending", code: null };
}

/**
 * Cancel an activation (setStatus=8).
 * Response: ACCESS_CANCEL or error string
 */
export async function tigerCancelOrder(activationId: string): Promise<boolean> {
  console.log(`[Tiger SMS] Attempting to cancel activation: ${activationId}`);
  
  try {
    const text = await tigerRequest({ action: "setStatus", id: activationId, status: "8" });
    console.log(`[Tiger SMS] Cancel response for ${activationId}: ${text}`);
    
    if (text === "ACCESS_CANCEL") {
      console.log(`[Tiger SMS] Cancellation confirmed for ${activationId}`);
      return true;
    }
    
    if (text === "EARLY_CANCEL_DENIED") {
      console.warn(`[Tiger SMS] Early cancel denied for ${activationId} - user must wait before cancelling`);
      throw new Error("Cannot cancel yet — please wait 1-2 minutes after purchase before cancelling.");
    }
    
    if (text === "NO_ACTIVATION") {
      throw new Error("Activation not found. It may have already expired.");
    }
    
    // Any other response is an error
    console.error(`[Tiger SMS] Unexpected cancel response for ${activationId}: ${text}`);
    throw new Error(`Tiger SMS cancel error: ${text}`);
  } catch (err: any) {
    console.error(`[Tiger SMS] Cancel API request failed for ${activationId}:`, err);
    throw err;
  }
}

/**
 * Finish/complete an activation (setStatus=6).
 */
export async function tigerFinishOrder(activationId: string): Promise<boolean> {
  const text = await tigerRequest({ action: "setStatus", id: activationId, status: "6" });
  if (text === "STATUS_OK") return true;
  if (text === "ACCESS_CANCEL") return true; // already cleaned up
  console.warn(`Tiger SMS finish returned: ${text}`);
  return true; // treat any response as ok for finish
}

/**
 * Ban order — report number as used and cancel (setStatus=8, which is also cancel on Tiger SMS).
 * Tiger SMS doesn't have a separate "ban" status so we use cancel (8).
 */
export async function tigerBanOrder(activationId: string): Promise<boolean> {
  return tigerCancelOrder(activationId);
}
