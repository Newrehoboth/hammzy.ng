import process from "node:process";
import fs from "node:fs";
import path from "node:path";
import servicesJsonRaw from "./services.json";

const BASE_URL = "https://api.tiger-sms.com/stubs/handler_api.php";

function getApiKey(): string {
  let key = process.env.TIGERSMS_API_KEY;
  if (!key) {
    try {
      const envPath = path.resolve(process.cwd(), ".env");
      if (fs.existsSync(envPath)) {
        const envContent = fs.readFileSync(envPath, "utf-8");
        const match = envContent.match(/^TIGERSMS_API_KEY\s*=\s*["']?([^"'\r\n]+)["']?/m);
        if (match && match[1]) {
          key = match[1];
        }
      }
    } catch (e) {
      console.warn("Failed to manually parse .env file for Tiger SMS key:", e);
    }
  }
  if (!key) throw new Error("TIGERSMS_API_KEY is not set in environment variables.");
  return key;
}

async function tigerRequest(params: Record<string, string>): Promise<string> {
  const qs = new URLSearchParams({ api_key: getApiKey(), ...params }).toString();
  const url = `${BASE_URL}?${qs}`;
  
  // Log the request (hide API key for security)
  const logParams = { ...params, api_key: "***" };
  console.log(`[Tiger SMS] API Request:`, logParams);
  
  const response = await fetch(url);
  if (!response.ok) {
    const text = await response.text().catch(() => `HTTP ${response.status}`);
    console.error(`[Tiger SMS] API HTTP Error (${response.status}):`, text);
    throw new Error(`Tiger SMS API error (${response.status}): ${text}`);
  }
  const text = await response.text();
  console.log(`[Tiger SMS] API Response:`, text.trim());
  return text.trim();
}

// ─── Service Code to Name Mapping ───────────────────────────────────────────

// Import services.json directly so it's bundled with the deployment
const serviceMap: Record<string, string> = servicesJsonRaw as Record<string, string>;
const reverseServiceMap: Record<string, string> = {};

// Build reverse mapping for lookups
Object.entries(serviceMap).forEach(([code, name]) => {
  // Normalize values to lowercase for case-insensitive lookup
  reverseServiceMap[name.toLowerCase()] = code.toLowerCase();
});

export function getServiceDisplayName(code: string): string {
  const name = serviceMap[code.toLowerCase()];
  if (name) return name;
  return code.charAt(0).toUpperCase() + code.slice(1);
}

export function getServiceCode(displayName: string): string {
  const code = reverseServiceMap[displayName.toLowerCase()];
  if (code) return code;
  // If not found directly, check for exact match in entries
  const entry = Object.entries(serviceMap).find(
    ([, val]) => val.toLowerCase() === displayName.toLowerCase()
  );
  if (entry) return entry[0];
  return displayName.toLowerCase();
}

// ─── Types ───────────────────────────────────────────────────────────────────

export interface TigerCountry {
  id: number;     // numeric country ID used in API calls
  name: string;
  iso: string;    // 2-letter ISO code (for flag display)
}

export interface TigerProduct {
  name: string;
  qty: number;
  price: number;  // already in USD (from API) — will be converted to ₦ upstream
}

export interface TigerSms {
  id: string;
  created_at: string;
  sender: string;
  text: string;
  code: string;
}

// Tiger SMS activation statuses
export type TigerOrderStatus = "pending" | "received" | "canceled" | "finished" | "banned" | "timeout";

export interface TigerOrder {
  id: string;         // activation ID
  phone: string;      // phone number (without leading +)
  service: string;
  country: number;    // numeric country ID
  price: number;      // price in USD
  status: TigerOrderStatus;
  expiresAt: string;  // ISO expiry time (estimated ~20 min from purchase)
  sms: TigerSms[];
}

// Raw getPrices response format:
// { "countryId": { "serviceCode": { "cost": "0.50", "count": 100 } } }
export type TigerPricesRaw = Record<
  string,
  Record<string, { cost: string; count: number }>
>;

